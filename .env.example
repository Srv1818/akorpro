# Site URL (kanonik URL'ler ve sitemap icin)
# NEXT_PUBLIC_SITE_URL=https://akorpro.com.tr

# Giris: yalnizca Google (Firebase Console -> Authentication -> Google).
# Istemci (Next.js bundle'a gider -- Web uygulamasi ayarlari)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sunucu: Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Tek satir JSON olarak .env.local'a yapistirin (tirnak icinde veya escape edilmis)
FIREBASE_SERVICE_ACCOUNT_KEY=

# App Check: reCAPTCHA Enterprise site key (Firebase Console -> App Check)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# On-demand ISR revalidation (POST /api/revalidate)
# Rastgele uzun string; moderasyon/admin araclari bu secret ile revalidate tetikler.
REVALIDATION_SECRET=

# Admin: custom claim bootstrap (POST /api/admin/claims)
# Rastgele uzun string; sadece server-to-server çağrıda Authorization: Bearer <secret> kullanın.
ADMIN_CLAIMS_SECRET=

# Google Analytics 4 — consent mode v2; omit to disable
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Sentry — error tracking; omit to disable
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# SENTRY_ORG=akorpro
# SENTRY_PROJECT=akorpro-web
# SENTRY_AUTH_TOKEN=  (CI/deploy only — source map upload)

# Web Vitals RUM — metrics beacon endpoint (optional; omit to log dev only)
# NEXT_PUBLIC_VITALS_ENDPOINT=https://akorpro.com.tr/api/vitals

# Firebase Emulator (Auth + Firestore)
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
# Seed script (emulator): FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# AKORPRO_SEED_UID=seed-demo-user
#
# DİKKAT: FIRESTORE_EMULATOR_HOST'u .env.local'da bırakmayın (Next sunucusu Admin ile emülatöre gider;
# emülatör yoksa yerelde şarkı/keşfet boş kalır). Seed için ayrı terminalde export edin veya:
# AKORPRO_ADMIN_USE_CLOUD_FIRESTORE=1  → Next hep canlı Firestore okur.

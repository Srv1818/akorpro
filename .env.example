# ── Payload ────────────────────────────────────────────────────────────────
# Postgres bağlantı dizesi. Yoksa hiçbir sayfa render edilemez.
DATABASE_URI=postgres://kullanici:parola@127.0.0.1:5432/akorpro

# Oturum çerezlerini imzalar. Uzun ve rastgele olmalı.
# Değiştirilirse herkesin oturumu düşer.
PAYLOAD_SECRET=

# ── Site ───────────────────────────────────────────────────────────────────
# Kanonik URL'ler, sitemap ve OAuth dönüş adresi bunu kullanır.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google ile giriş (istege bagli) ────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client.
# İzinli redirect URI olarak şunu ekleyin:
#   <NEXT_PUBLIC_SITE_URL>/payload-api/users/oauth/callback
# Boş bırakılırsa Google düğmesi hiç görünmez; parola girişi yine çalışır.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=1

# ── Dosya depolama: Cloudflare R2 (istege bagli) ───────────────────────────
# Dördü birden tanımlı değilse yüklemeler yerel dosya sistemine gider.
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# Yüklenen dosyaların herkese açık adresi — CSP img-src'ye eklenir.
# NEXT_PUBLIC_MEDIA_URL=

# ── On-demand ISR ──────────────────────────────────────────────────────────
# POST /api/revalidate bu secret ile tetiklenir.
REVALIDATION_SECRET=

# ── Izleme (istege bagli) ──────────────────────────────────────────────────
# GA4 ve Clarity doğrudan yüklenmiyor; ikisi de GTM kapsayıcısının içinde.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=akorpro
# SENTRY_PROJECT=akorpro-web
# SENTRY_AUTH_TOKEN=   (yalnız CI/deploy — source map yükleme)
# NEXT_PUBLIC_VITALS_ENDPOINT=

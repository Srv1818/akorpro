# Giriş: yalnızca Google (Firebase Console → Authentication → Google).
# İstemci (Next.js bundle’a gider — Web uygulaması ayarları)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sunucu: Firebase Console → Project settings → Service accounts → Generate new private key
# Tek satır JSON olarak .env.local’a yapıştırın (tırnak içinde veya escape edilmiş)
FIREBASE_SERVICE_ACCOUNT_KEY=

# App Check: reCAPTCHA Enterprise site key (Firebase Console → App Check)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# On-demand ISR revalidation (POST /api/revalidate)
# Rastgele uzun string; moderasyon/admin araçları bu secret ile revalidate tetikler.
REVALIDATION_SECRET=

# İsteğe bağlı — Firebase Emulator (Auth + Firestore)
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
# Seed script (emulator): FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# AKORPRO_SEED_UID=seed-demo-user

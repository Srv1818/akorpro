rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Custom claim `admin` (boolean) — Console / Admin SDK ile atanır. */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    /* ---- Şarkılar (songs) ---- */
    match /songs/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---- Sanatçılar (artists) ---- */
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---- Keşfet (discover) ---- */
    match /discover/{section} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---- Kullanıcı: çalma listeleri ---- */
    match /users/{userId}/playlists/{playlistId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/playlists/{playlistId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    /* ---- Kullanıcı: songOverrides ---- */
    match /users/{userId}/songOverrides/{songId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    /** users/{userId} kök dokümanı — şimdilik kapalı. */
    match /users/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
